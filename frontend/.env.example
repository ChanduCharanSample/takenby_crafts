# =====================================================
# Craftora Frontend - Environment Configuration
# Copy this file to `.env` in the frontend directory.
# =====================================================

# Full URL of the deployed backend API (without trailing slash).
# In local dev leave this EMPTY so Vite proxies /api to localhost:5000.
# After deploy (Vercel + Render), set it to your Render backend, e.g.:
# VITE_API_URL=https://craftora-backend.onrender.com
VITE_API_URL=
