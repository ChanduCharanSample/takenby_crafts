# =====================================================
# Craftora Backend - Environment Configuration
# Copy this file to `.env` and fill in your values.
# =====================================================

# ---- Server ----
PORT=5000

# ---- Database (MongoDB) ----
# Local:    mongodb://127.0.0.1:27017/craftora
# MongoDB Atlas: replace with your cluster connection string
MONGO_URI=mongodb://127.0.0.1:27017/craftora

# ---- Auth ----
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Frontend origin (for CORS) ----
# Local dev Vite server:
CLIENT_URL=http://localhost:5173
# After deploy, set to your Vercel/Netlify URL, e.g. https://craftora.vercel.app

# ---- Admin (private credentials) ----
ADMIN_EMAIL=admin@craftora.com
ADMIN_PASSWORD=Craftora@123

# ---- Email / SMTP (Nodemailer) ----
# Gmail example: EMAIL_USER=<you>@gmail.com, EMAIL_PASS=<app password>
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
OTP_EXPIRY=10

# ---- Cloudinary (image hosting) ----
# When all three are set, uploaded images are stored on Cloudinary and
# the secure URL is saved to the database (required for Render deploy).
# Leave empty to store images locally under backend/uploads (dev only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Deployment URLs (optional) ----
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
